{
  "name": "orbitdesk-ai-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Clean-room multi-workspace browser and authorized AI generation task console.",
  "type": "module",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && npm run build:electron && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "dev:web": "vite --host 0.0.0.0",
    "build": "npm run typecheck && vite build && npm run build:electron",
    "build:electron": "tsc -p tsconfig.electron.json",
    "typecheck": "tsc -p tsconfig.renderer.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "preview": "vite preview --host 0.0.0.0",
    "package:win": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "lucide-react": "1.58.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "concurrently": "9.2.1",
    "cross-env": "10.1.0",
    "electron": "44.8.0",
    "electron-builder": "26.15.3",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7",
    "wait-on": "9.0.3"
  },
  "build": {
    "appId": "ai.orbitdesk.studio",
    "productName": "OrbitDesk AI Studio",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "OrbitDesk-AI-Studio-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
